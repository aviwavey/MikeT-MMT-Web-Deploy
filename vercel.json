{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "framework": null,
  "routes": [
    { "src": "/", "status": 307, "headers": { "Location": "/MikeT.MMT" } },
    { "src": "/(?:favicon.ico|brand.webp)", "dest": "/MikeT.MMT/brand.webp" },
    { "src": "/MikeT\\.MMT/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/MikeT\\.MMT(?:/(?:mic|mix|track))?/?", "dest": "/MikeT.MMT/index.html", "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "X-Mike-Site": "standalone" } },
    { "src": "/(?:mike-t|miket\\.mmt)(/.*)?", "status": 307, "headers": { "Location": "/MikeT.MMT$1" } }
  ]
}
